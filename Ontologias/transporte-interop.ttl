@prefix ecsns: <http://www.semanticweb.org/ecsdi/ontologies/2026/e-shop#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

# Fragmento mínimo para interoperabilidad entre grupos (agentes transportistas).
# Namespace obligatorio en todos los mensajes ACL de transporte.

ecsns:CFP a owl:Class ;
    rdfs:label "Call For Proposal (solicitud de oferta de envío)" ;
    rdfs:comment "Enviada por Ag.Logistico con ACL.request." .

ecsns:Oferta a owl:Class ;
    rdfs:subClassOf ecsns:OfertaTransporte ;
    rdfs:label "Oferta de transporte (ronda 1 o contraoferta del transportista)" .

ecsns:ContraOferta a owl:Class ;
    rdfs:label "Contraoferta del centro logístico" ;
    rdfs:comment "Enviada con ACL.propose; solo ecsns:tienePrecio." .

ecsns:tieneDestino a owl:DatatypeProperty ;
    rdfs:domain ecsns:CFP ;
    rdfs:range rdfs:Literal .

ecsns:tienePrioridad a owl:DatatypeProperty ;
    rdfs:domain ecsns:CFP ;
    rdfs:range rdfs:Literal ;
    rdfs:comment "Valores: normal, urgente, economica." .

ecsns:tienePrecio a owl:DatatypeProperty ;
    rdfs:range rdfs:Literal .

ecsns:tieneFechaEntrega a owl:DatatypeProperty ;
    rdfs:range rdfs:Literal ;
    rdfs:comment "Formato YYYY-MM-DD." .

ecsns:tieneTransportista a owl:DatatypeProperty ;
    rdfs:range rdfs:Literal .

ecsns:ciudad a owl:DatatypeProperty ;
    rdfs:comment "Ciudad de cobertura; se registra en el DS junto al agente." .

# Performatives ACL (no forman parte de la ontología de dominio):
# CFP -> request + contenido CFP
# Oferta inicial -> propose + contenido Oferta
# Contraoferta logístico -> propose + contenido ContraOferta
# Aceptación contraoferta -> inform (sin contenido de precio)
# Nueva propuesta transportista -> propose + contenido Oferta
# Rechazo -> reject-proposal
# Decisión final -> accept-proposal | reject-proposal
