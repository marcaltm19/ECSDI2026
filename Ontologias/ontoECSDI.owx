    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#factura</IRI>
        <Literal xml:lang="es">Vincula el mensaje o acción informativa de facturación con la entidad de la factura digital que se está transmitiendo.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#fecha</IRI>
        <Literal xml:lang="es">Marca de tiempo genérica que registra el momento exacto. Entre otros usos nos sirve para guardar cuándo se ha realizado un pedido.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
