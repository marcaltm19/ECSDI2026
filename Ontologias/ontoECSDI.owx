    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Accion</IRI>
        <Literal xml:lang="es">Clase abstracta base de la que heredan todas las solicitudes operativas o directivas que un agente pide realizar a otro.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Ag.GestorDePagos</IRI>
        <Literal xml:lang="es">Agente encargado de gestionar los cobros al usuario y los pagos a los vendedores externos. Intermedia los protocolos Envío realizado (recibe del Logístico), Información pago (recibe del Gestor de pedidos) y Compra completada (informa a Experiencia).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#CategoriaProducto</IRI>
        <Literal xml:lang="es">Clasificación taxonómica utilizada para organizar el catálogo de productos y facilitar las restricciones de búsqueda.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#CentroLogistico</IRI>
        <Literal xml:lang="es">Instalación distribuida encargada del almacenamiento de productos, preparación de paquetes, agrupación en lotes y negociación del transporte.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#CompraProducto</IRI>
        <Literal xml:lang="es">Línea de detalle dentro de un pedido que asocia un producto concreto con la cantidad exacta adquirida.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Comunicacion</IRI>
        <Literal xml:lang="es">Clase raíz abstracta para modelar todos los flujos de interacción, mensajes y contenidos que se intercambian los agentes.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#ConsultaDevoluciones</IRI>
        <Literal xml:lang="es">Solicitud enviada por un agente para obtener el listado de devoluciones registradas para un comprador o pedido concreto.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Devolucion</IRI>
        <Literal xml:lang="es">Proceso global de gestión del retorno de un producto y la consecuente restitución económica al comprador. El proceso de devolución se pone en marcha una vez se ha aceptado la solicitud de devolución que ha hecho el usuario.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Devolucion</IRI>
        <Literal xml:lang="es">Proceso global de gestión del retorno de un producto. Actúa como entidad de dominio (persistida en listado_devoluciones.json) y como respuesta al mensaje SolicitudDevolucion, transportando el resultado de la evaluación (aceptada/rechazada, motivo, empresa de mensajería).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#DevolucionAceptada</IRI>
        <Literal xml:lang="es">Notificación proactiva enviada por el agente de devoluciones al agente de experiencia cuando una solicitud de devolución es aceptada, para que este elimine la compra del historial del cliente.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Direccion</IRI>
        <Literal xml:lang="es">Estructura de datos que almacena los componentes geográficos (calle, número, código postal, ciudad, país) de un domicilio o instalación (centro logístico, por ejemplo).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#EmpresaTransporte</IRI>
        <Literal xml:lang="es">Agente logístico externo encargado del traslado físico de las mercancías desde los centros logísticos hasta el usuario.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Factura</IRI>
        <Literal xml:lang="es">Documento legal e impositivo emitido tras un cobro que detalla el desglose de importes, subtotales e impuestos de un pedido.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Feedback</IRI>
        <Literal xml:lang="es">Registro de la valoración cualitativa (reseña) y cuantitativa (puntuación) efectuada por un cliente sobre un producto.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#InformacionPago</IRI>
        <Literal xml:lang="es">Mensaje enviado por el Gestor de pedidos al Gestor de pagos con el método de pago del usuario, activando el protocolo Información pago (Pr).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#ConfirmacionEnvio</IRI>
        <Literal xml:lang="es">Notificación enviada por el AgenteLogistico o el Gestor de pedidos al Gestor de pagos cuando un envío se ha realizado, desencadenando el cobro al usuario.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#SolicitudReembolso</IRI>
        <Literal xml:lang="es">Solicitud de devolución económica enviada al AgenteGestorPagos con el identificador de pedido y comprador.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Marca</IRI>
        <Literal xml:lang="es">Firma comercial o fabricante asociado a un producto específico.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#OfertaTransporte</IRI>
        <Literal xml:lang="es">Propuesta económica y temporal emitida por un transportista (o &apos;EmrpesaTransporte&apos;) como respuesta a una solicitud de envío de un lote de pedidos.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Pedido</IRI>
        <Literal xml:lang="es">Registro que consolida la solicitud de compra de un usuario, agrupando costes totales, prioridades y datos de envío proporcionados por el usuario. El pedido se pone en marcha una vez el usuario ha efectuado el pago de los productos que quiere comprar.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Producto</IRI>
        <Literal xml:lang="es">Elemento o artículo comercial disponible en el catálogo para ser comprado por los usuarios, con atributos indispensables como el precio, peso y descripción.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Respuesta</IRI>
        <Literal xml:lang="es">Clase abstracta que engloba aquellos mensajes que sirven como réplica, entrega de datos o confirmación a una acción previa.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#ResultadoVerificacion</IRI>
        <Literal xml:lang="es">Respuesta del gestor de pedidos a una VerificarCompra. Indica si la compra es válida para iniciar una devolución (aceptada) y, en caso contrario, el motivo del rechazo.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#SolicitudPedido</IRI>
        <Literal xml:lang="es">Mensaje de acción que inicia el procesamiento de una compra. Lo envía el agente usuario al gestor de pedidos y, posteriormente, el gestor al agente logístico. Transporta los datos operativos del pedido (comprador, dirección, prioridad, productos), pero es semánticamente distinto de la entidad Pedido, que representa la instancia persistida en la base de datos.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#TiendaExterna</IRI>
        <Literal xml:lang="es">Vendedor o comercio de terceros integrado en la plataforma que provee sus propios productos y recibe pagos de la tienda principal (nuestro sistema). La tienda (nuestro sistema) vende estos productos de terceros, pero es la tienda externa la que se encarga de la gestión de sus productos (devolución, envío a domicilio).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Usuario</IRI>
        <Literal xml:lang="es">Representa al cliente final de la plataforma, que interactúa a través de su agente para realizar búsquedas, compras y valoraciones.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#VerificarCompra</IRI>
        <Literal xml:lang="es">Solicitud enviada por el agente de devoluciones al gestor de pedidos para comprobar si una factura existe, pertenece al comprador indicado y no ha sido ya devuelta.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#aceptada</IRI>
        <Literal xml:lang="es">Indica si una verificación de compra o una solicitud de devolución ha sido aceptada (true) o rechazada (false).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#actualizado</IRI>
        <Literal xml:lang="es">Indica si una actualización de catálogo ha sido procesada correctamente por el AgenteVendedorExterno.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#cantidad</IRI>
        <Literal xml:lang="es">Número de unidades de un producto incluidas en un pedido o compra.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#categoria</IRI>
        <Literal xml:lang="es">Categoría de un producto (Electronica, Hogar, Moda, etc.) usada como filtro en búsquedas y en el catálogo del comprador.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#ciudad</IRI>
        <Literal xml:lang="es">Ciudad de cobertura de un AgenteTransportista, usada por el AgenteLogístico para filtrar transportistas según el centro logístico de origen.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#comentario</IRI>
        <Literal xml:lang="es">Texto libre del comprador que acompaña la puntuación de una valoración de producto.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#comprador</IRI>
        <Literal xml:lang="es">Nombre del comprador o usuario que origina o protagoniza una comunicación entre agentes.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#datosProveedor</IRI>
        <Literal xml:lang="es">Información de registro o identificador de transacciones devuelto por la pasarela de pago de un vendedor externo.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#direccion</IRI>
        <Literal xml:lang="es">Dirección postal completa de entrega de un pedido, expresada como cadena de texto.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#empresaMensajeria</IRI>
        <Literal xml:lang="es">Nombre de la empresa de mensajería asignada para gestionar la recogida de un producto devuelto.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#estado</IRI>
        <Literal xml:lang="es">Estado de tramitación de un pedido externo tal como lo informa el AgenteVendedorExterno (confirmado, en preparación, enviado, etc.).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#fecha</IRI>
        <Literal xml:lang="es">Marca temporal de una compra, factura o entrada de historial, expresada como cadena ISO 8601.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#fechaEntrega</IRI>
        <Literal xml:lang="es">Fecha estimada de entrega al cliente comunicada por un AgenteVendedorExterno en su respuesta a un pedido externo.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#fechaRecepcion</IRI>
        <Literal xml:lang="es">Fecha en que el comprador afirma haber recibido el producto, requerida para iniciar el plazo de devolución.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#gestionEnvio</IRI>
        <Literal xml:lang="es">Indica quién gestiona el envío del producto: la tienda propia o el vendedor externo. Valores: tienda, vendedor.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#idDevolucion</IRI>
        <Literal xml:lang="es">Identificador único generado para una devolución aceptada, usado para rastrear su estado.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#idEnvio</IRI>
        <Literal xml:lang="es">Identificador único de un sub-envío generado por el AgenteLogístico al asignar un transportista.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#idFactura</IRI>
        <Literal xml:lang="es">Identificador único de una factura, usado como referencia en solicitudes de devolución y confirmaciones de pago.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#idPedido</IRI>
        <Literal xml:lang="es">Identificador único de un pedido a lo largo de todo su ciclo de vida en el sistema.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#idProducto</IRI>
        <Literal xml:lang="es">Identificador único de un producto en el catálogo, usado como referencia en pedidos, valoraciones y envíos.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#idValoracion</IRI>
        <Literal xml:lang="es">Identificador único asignado a una valoración registrada, devuelto por el AgenteExperiencia en la confirmación ValoracionOK.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#incluirExternos</IRI>
        <Literal xml:lang="es">Indica si la búsqueda debe incluir productos de vendedores externos además del catálogo propio.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#mediaValoracion</IRI>
        <Literal xml:lang="es">Media aritmética de las puntuaciones recibidas por un producto, calculada por el AgenteExperiencia.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#metodoPago</IRI>
        <Literal xml:lang="es">Método de pago elegido por el comprador al realizar el pedido (tarjeta, transferencia, etc.).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#motivo</IRI>
        <Literal xml:lang="es">Explicación textual del resultado de una verificación de compra, indicando por qué fue aceptada o rechazada.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#motivoDevolucion</IRI>
        <Literal xml:lang="es">Motivo detallado por el que se acepta o rechaza la devolución, comunicado por el AgenteDevolucion al usuario.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#nombre</IRI>
        <Literal xml:lang="es">Nombre legible de un producto, recomendación u otro elemento identificable del catálogo.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#nombreVendedor</IRI>
        <Literal xml:lang="es">Nombre de la tienda externa o vendedor propietario de un producto externo dentro del catálogo.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#numEnvios</IRI>
        <Literal xml:lang="es">Número total de sub-envíos en que se ha dividido un pedido, según el número de centros logísticos implicados.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#numeroTarjeta</IRI>
        <Literal xml:lang="es">Número de tarjeta bancaria del comprador, usado para procesar el pago en la pasarela externa.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#peso</IRI>
        <Literal xml:lang="es">Masa del producto en kilogramos, usada para calcular tarifas de transporte y agrupar lotes de envío.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#precio</IRI>
        <Literal xml:lang="es">Precio unitario de venta de un producto al público.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#precioMaximo</IRI>
        <Literal xml:lang="es">Filtro opcional de búsqueda que limita los resultados a productos con precio igual o inferior al valor indicado.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#prioridad</IRI>
        <Literal xml:lang="es">Nivel de urgencia del pedido que determina el criterio de selección del transportista: urgente (más rápido), normal o economica (más barato).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#puntuacion</IRI>
        <Literal xml:lang="es">Puntuación numérica de 1 a 5 asignada por el comprador a un producto en su valoración.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#razonDevolucion</IRI>
        <Literal xml:lang="es">Motivo alegado por el comprador para solicitar la devolución de un producto (defectuoso, no coincide con descripción, etc.).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#razonRecomendacion</IRI>
        <Literal xml:lang="es">Explicación textual de por qué el AgenteExperiencia recomienda un producto (bien valorado, popular, misma categoría, etc.).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#stock</IRI>
        <Literal xml:lang="es">Número de unidades disponibles de un producto en el catálogo en el momento de la búsqueda.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#tieneCentro</IRI>
        <Literal xml:lang="es">Nombre del centro logístico asignado a un producto en el pedido, propagado desde el AgenteGestorPedidos al AgenteLogístico.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#tieneDestino</IRI>
        <Literal xml:lang="es">Dirección de entrega comunicada en el CFP para que los transportistas puedan calcular su oferta de precio y plazo.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#tieneFechaEntrega</IRI>
        <Literal xml:lang="es">Fecha prevista de entrega al cliente (formato YYYY-MM-DD) incluida en una oferta de transporte o sub-envío.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#tieneFeedback</IRI>
        <Literal xml:lang="es">Enlaza una SolicitudFeedback con la entidad Feedback que contiene los datos del producto y comprador a valorar. Implementa el patrón wrapper entre el mensaje de solicitud y la entidad de dominio.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#tienePrecio</IRI>
        <Literal xml:lang="es">Precio propuesto por un transportista en una oferta o contraoferta durante la negociación Contract Net.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#tienePrioridad</IRI>
        <Literal xml:lang="es">Nivel de prioridad del envío comunicado en el CFP (urgente, normal, economica), usado por los transportistas para calcular su oferta.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#tieneProductoId</IRI>
        <Literal xml:lang="es">Identificador de un producto incluido en un sub-envío, comunicado como literal en la notificación al usuario y al gestor.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#tieneTransportista</IRI>
        <Literal xml:lang="es">Nombre de la empresa transportista que propone el envío en una oferta del protocolo Contract Net.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#total</IRI>
        <Literal xml:lang="es">Importe total de una factura o compra finalizada, calculado como suma de los precios por cantidades de todos los productos.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#totalValoraciones</IRI>
        <Literal xml:lang="es">Número total de valoraciones recibidas por un producto, incluido en el ResultadoValoraciones.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#transportista</IRI>
        <Literal xml:lang="es">Nombre de la empresa de mensajería con la que el vendedor externo gestiona sus propios envíos.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#valoracion</IRI>
        <Literal xml:lang="es">Valoración media de un producto en el catálogo, usada por el AgenteExperiencia para filtrar recomendaciones.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#valoracionMinima</IRI>
        <Literal xml:lang="es">Filtro opcional de búsqueda que limita los resultados a productos con valoración media igual o superior al valor indicado.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#vendedor</IRI>
        <Literal xml:lang="es">Nombre de la tienda externa propietaria de un producto, usado para identificar a qué vendedor debe dirigirse un pedido externo.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#AckActualizacion</IRI>
        <Literal xml:lang="es">Confirmación enviada por el AgenteVendedorExterno al recibir correctamente una solicitud de actualización de su catálogo de productos.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#ActualizarCatalogo</IRI>
        <Literal xml:lang="es">Acción enviada al AgenteVendedorExterno para sincronizar el inventario de sus productos con los datos más recientes.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Ag.Comprador</IRI>
        <Literal xml:lang="es">Agente encargado de gestionar las búsquedas de productos en el catálogo interno y en los vendedores externos, aplicando filtros de nombre, categoría, precio y valoración.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Ag.Devolucion</IRI>
        <Literal xml:lang="es">Agente responsable de tramitar las solicitudes de devolución, verificando la compra con el gestor de pedidos y comunicando la resolución al usuario y al agente de experiencia.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Ag.Experiencia</IRI>
        <Literal xml:lang="es">Agente que gestiona el historial de compras, las valoraciones de productos y la generación de recomendaciones personalizadas, tanto bajo petición como de forma proactiva.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Ag.GestorDePedidos</IRI>
        <Literal xml:lang="es">Agente central que procesa las compras recibidas del usuario, coordina los envíos con el agente logístico, delega los pedidos a vendedores externos y emite las facturas correspondientes.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Ag.Logistico</IRI>
        <Literal xml:lang="es">Agente que gestiona la asignación de envíos a empresas de transporte mediante el protocolo Contract Net, agrupando los productos por centro logístico de origen.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Ag.Transportista</IRI>
        <Literal xml:lang="es">Agente que representa a una empresa de transporte. Recibe CFPs del agente logístico, propone precio y fecha de entrega, y negocia mediante contraoferta.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Ag.Usuario</IRI>
        <Literal xml:lang="es">Agente interfaz web que recibe las interacciones del cliente final, construye los mensajes ontológicos y los despacha a los agentes especializados del sistema.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Ag.VendedorExterno</IRI>
        <Literal xml:lang="es">Agente que representa a una tienda de terceros integrada en la plataforma. Gestiona su propio catálogo y tramita los pedidos que le envía el gestor de pedidos.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Busqueda</IRI>
        <Literal xml:lang="es">Acción enviada por el AgenteUsuario al AgenteComprador para buscar productos aplicando filtros opcionales de categoría, precio máximo y valoración mínima.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#CFP</IRI>
        <Literal xml:lang="es">Call for Proposals enviado por el AgenteLogístico a todos los transportistas registrados para iniciar la primera ronda de negociación del protocolo Contract Net.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#CatalogoExterno</IRI>
        <Literal xml:lang="es">Respuesta enviada por el AgenteVendedorExterno con los productos de su catálogo que coinciden con los criterios de una búsqueda.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Cobrar</IRI>
        <Literal xml:lang="es">Clase abstracta para acciones de cobro al comprador, implementada por el AgenteGestorPagos.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#CobrarPedido</IRI>
        <Literal xml:lang="es">Acción de cobro específica asociada a un pedido concreto, ejecutada por el AgenteGestorPagos tras la confirmación de envío.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#CompraFinalizada</IRI>
        <Literal xml:lang="es">Notificación enviada por el AgenteGestorPagos al AgenteExperiencia para registrar una compra completada en el historial del comprador.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#ConsultaHistorial</IRI>
        <Literal xml:lang="es">Acción enviada al AgenteExperiencia para obtener el historial de pedidos y productos comprados por un comprador concreto.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#ConsultaValoraciones</IRI>
        <Literal xml:lang="es">Acción enviada al AgenteExperiencia para obtener la media, el total y el detalle de valoraciones de un producto identificado por su id.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#ContraOferta</IRI>
        <Literal xml:lang="es">Propuesta de precio enviada por el AgenteLogístico a un transportista en la segunda ronda del protocolo Contract Net, ofreciendo un precio inferior al mínimo recibido en la primera ronda.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#EnviosAsignados</IRI>
        <Literal xml:lang="es">Notificación enviada por el AgenteLogístico al AgenteExperiencia con los sub-envíos asignados a un pedido, para programar las solicitudes de feedback tras la entrega.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#HistorialCompras</IRI>
        <Literal xml:lang="es">Respuesta del AgenteExperiencia con el listado de pedidos y productos comprados por un comprador, incluyendo fechas y totales.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Informar</IRI>
        <Literal xml:lang="es">Clase abstracta para mensajes que comunican proactivamente un resultado, estado o decisión sin que haya una petición previa explícita del receptor.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#InformarDesicion</IRI>
        <Literal xml:lang="es">Mensaje enviado por el AgenteDevolucion al AgenteUsuario con el resultado de una solicitud de devolución, indicando si fue aceptada o rechazada y la empresa de mensajería asignada.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#ListaDevoluciones</IRI>
        <Literal xml:lang="es">Respuesta del AgenteDevolucion con el listado de devoluciones registradas para un comprador o pedido determinado.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#ListarProductos</IRI>
        <Literal xml:lang="es">Acción para obtener el catálogo completo de productos disponibles. Usada internamente por el AgenteExperiencia para calcular recomendaciones personalizadas.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#NotificacionEnvios</IRI>
        <Literal xml:lang="es">Mensaje enviado por el AgenteGestorPedidos al AgenteUsuario con los sub-envíos logísticos asignados a un pedido, para mostrárselos al cliente en la confirmación.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#NuevaValoracion</IRI>
        <Literal xml:lang="es">Acción enviada por el AgenteUsuario al AgenteExperiencia para registrar la puntuación y comentario de un comprador sobre un producto de un pedido concreto.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#ObtenerProveedorPago</IRI>
        <Literal xml:lang="es">Acción para consultar la pasarela de pago asociada a una tienda externa, implementada entre AgenteGestorPagos y AgenteVendedorExterno.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Oferta</IRI>
        <Literal xml:lang="es">Propuesta de precio y fecha de entrega enviada por un AgenteTransportista al AgenteLogístico en respuesta a un CFP o a una contraoferta aceptada.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#PagarVendedor</IRI>
        <Literal xml:lang="es">Acción de transferencia económica a un vendedor externo tras completarse una venta de sus productos, ejecutada por el AgenteGestorPagos.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#PedidoExterno</IRI>
        <Literal xml:lang="es">Acción enviada por el AgenteGestorPedidos a un AgenteVendedorExterno para encargarle los productos de su catálogo incluidos en una compra.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#PedirRecomendaciones</IRI>
        <Literal xml:lang="es">Acción enviada por el AgenteUsuario al AgenteExperiencia para obtener productos recomendados basados en el historial de compras y búsquedas del comprador.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#PedirReembolso</IRI>
        <Literal xml:lang="es">Acción enviada por el AgenteDevolucion al AgenteVendedorExterno para solicitar la devolución del importe de un producto externo retornado por el comprador.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#ProductoExterno</IRI>
        <Literal xml:lang="es">Artículo perteneciente al catálogo de un vendedor externo, con su propio identificador, precio y nombre tal como los gestiona la tienda de terceros.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Proponer</IRI>
        <Literal xml:lang="es">Clase abstracta para mensajes que contienen una propuesta dentro de un protocolo de negociación. Sin subclases activas en el sistema actual.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#ReciboProveedorPago</IRI>
        <Literal xml:lang="es">Respuesta del AgenteVendedorExterno con el identificador del proveedor de pago de la tienda.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Recomendaciones</IRI>
        <Literal xml:lang="es">Respuesta del AgenteExperiencia con una lista de productos recomendados para un comprador, incluyendo la razón de cada recomendación y su valoración media.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#RecomendacionesProactivas</IRI>
        <Literal xml:lang="es">Mensaje enviado periódicamente por el AgenteExperiencia al AgenteUsuario con recomendaciones calculadas sin que haya mediado una petición explícita del usuario.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Reembolsar</IRI>
        <Literal xml:lang="es">Clase abstracta para acciones de reintegro económico al comprador. Implementada mediante SolicitudReembolso en el AgenteGestorPagos.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#RegistroBusqueda</IRI>
        <Literal xml:lang="es">Notificación enviada por el AgenteComprador al AgenteExperiencia con los parámetros de una búsqueda realizada, para registrar el historial de búsquedas del comprador.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#RespuestaPedidoExterno</IRI>
        <Literal xml:lang="es">Confirmación enviada por el AgenteVendedorExterno al AgenteGestorPedidos con el estado, la empresa de mensajería y la fecha estimada de entrega de un pedido externo.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#ResultadoEnvio</IRI>
        <Literal xml:lang="es">Respuesta del AgenteLogístico al AgenteGestorPedidos con los sub-envíos asignados tras completar la negociación de transporte para un pedido.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#ResultadoValoraciones</IRI>
        <Literal xml:lang="es">Respuesta del AgenteExperiencia con la media, el total de valoraciones y el detalle de cada reseña para un producto solicitado.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#SolicitudDevolucion</IRI>
        <Literal xml:lang="es">Acción enviada por el AgenteUsuario al AgenteDevolucion para iniciar el proceso de devolución de una factura, indicando el motivo y la fecha de recepción del producto.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#SolicitudFeedback</IRI>
        <Literal xml:lang="es">Acción enviada por el AgenteExperiencia al AgenteUsuario para solicitar al comprador que valore un producto tras su fecha prevista de entrega. Actúa como wrapper de la entidad Feedback.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#ValoracionOK</IRI>
        <Literal xml:lang="es">Confirmación enviada por el AgenteExperiencia al AgenteUsuario tras registrar correctamente la valoración de un producto.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#tieneDevolucion</IRI>
        <Literal xml:lang="es">Enlaza un nodo ListaDevoluciones con cada instancia Devolucion individual que contiene, permitiendo iterar sobre el listado de devoluciones de un comprador.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#tienePedido</IRI>
        <Literal xml:lang="es">Enlaza una SolicitudPedido con la entidad Pedido que contiene los datos operativos de la compra. Implementa el patrón wrapper entre el mensaje de comunicación y la entidad de dominio.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#tieneProducto</IRI>
        <Literal xml:lang="es">Enlaza un Pedido, CompraFinalizada o mensaje de envío con los nodos de producto que contiene, permitiendo iterar sobre los artículos de una compra o notificación.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#tieneRecomendacion</IRI>
        <Literal xml:lang="es">Enlaza un mensaje Recomendaciones o RecomendacionesProactivas con cada nodo de producto recomendado individual, incluyendo su razón y valoración media.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#tieneSubEnvio</IRI>
        <Literal xml:lang="es">Enlaza un ResultadoEnvio o NotificacionEnvios con cada sub-envío individual, donde cada sub-envío agrupa los productos enviados desde un mismo centro logístico con un transportista concreto.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#tieneValoracion</IRI>
        <Literal xml:lang="es">Enlaza un ResultadoValoraciones con cada instancia de valoración individual registrada por un comprador para un producto concreto.</Literal>
    </AnnotationAssertion>
</Ontology>



