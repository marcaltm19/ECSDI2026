    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Accion</IRI>
        <Literal xml:lang="es">Clase abstracta base de la que heredan todas las solicitudes operativas o directivas que un agente pide realizar a otro.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#CategoriaProducto</IRI>
        <Literal xml:lang="es">Clasificación taxonómica utilizada para organizar el catálogo de productos y facilitar las restricciones de búsqueda.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#CentroLogistico</IRI>
        <Literal xml:lang="es">Instalación distribuida encargada del almacenamiento de productos, preparación de paquetes, agrupación en lotes y negociación del transporte.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#CompraProducto</IRI>
        <Literal xml:lang="es">Línea de detalle dentro de un pedido que asocia un producto concreto con la cantidad exacta adquirida.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Comunicacion</IRI>
        <Literal xml:lang="es">Clase raíz abstracta para modelar todos los flujos de interacción, mensajes y contenidos que se intercambian los agentes.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Devolucion</IRI>
        <Literal xml:lang="es">Proceso global de gestión del retorno de un producto y la consecuente restitución económica al comprador. El proceso de devolución se pone en marcha una vez se ha aceptado la solicitud de devolución que ha hecho el usuario.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Direccion</IRI>
        <Literal xml:lang="es">Estructura de datos que almacena los componentes geográficos (calle, número, código postal, ciudad, país) de un domicilio o instalación (centro logístico, por ejemplo).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#EmpresaTransporte</IRI>
        <Literal xml:lang="es">Agente logístico externo encargado del traslado físico de las mercancías desde los centros logísticos hasta el usuario.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Factura</IRI>
        <Literal xml:lang="es">Documento legal e impositivo emitido tras un cobro que detalla el desglose de importes, subtotales e impuestos de un pedido.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Feedback</IRI>
        <Literal xml:lang="es">Registro de la valoración cualitativa (reseña) y cuantitativa (puntuación) efectuada por un cliente sobre un producto.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Marca</IRI>
        <Literal xml:lang="es">Firma comercial o fabricante asociado a un producto específico.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#OfertaTransporte</IRI>
        <Literal xml:lang="es">Propuesta económica y temporal emitida por un transportista (o &apos;EmrpesaTransporte&apos;) como respuesta a una solicitud de envío de un lote de pedidos.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Pedido</IRI>
        <Literal xml:lang="es">Registro que consolida la solicitud de compra de un usuario, agrupando costes totales, prioridades y datos de envío proporcionados por el usuario. El pedido se pone en marcha una vez el usuario ha efectuado el pago de los productos que quiere comprar.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#PeticionDevolucion</IRI>
        <Literal xml:lang="es">Instancia formal enviada por el usuario donde se especifica el producto a retornar y el motivo detallado de la reclamación.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Producto</IRI>
        <Literal xml:lang="es">Elemento o artículo comercial disponible en el catálogo para ser comprado por los usuarios, con atributos indispensables como el precio, peso y descripción.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Respuesta</IRI>
        <Literal xml:lang="es">Clase abstracta que engloba aquellos mensajes que sirven como réplica, entrega de datos o confirmación a una acción previa.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#TiendaExterna</IRI>
        <Literal xml:lang="es">Vendedor o comercio de terceros integrado en la plataforma que provee sus propios productos y recibe pagos de la tienda principal (nuestro sistema). La tienda (nuestro sistema) vende estos productos de terceros, pero es la tienda externa la que se encarga de la gestión de sus productos (devolución, envío a domicilio).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Usuario</IRI>
        <Literal xml:lang="es">Representa al cliente final de la plataforma, que interactúa a través de su agente para realizar búsquedas, compras y valoraciones.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#calle</IRI>
        <Literal xml:lang="es">Nombre de la vía pública o calzada que compone la dirección postal.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#cantidad</IRI>
        <Literal xml:lang="es">Número de unidades físicas adquiridas de un mismo producto dentro de una línea de compra.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#ciudad</IRI>
        <Literal xml:lang="es">Municipio, localidad o urbe a la que pertenece la dirección.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#codigoPostal</IRI>
        <Literal xml:lang="es">distrito que identifica la zona geográfica exacta del envío.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#compra</IRI>
        <Literal xml:lang="es">Relación utilizada dentro del mensaje de compra para identificar el productoes de catálogo involucrado en la transacción de la línea.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#compuestoDe</IRI>
        <Literal xml:lang="es">Relación estructural que desglosa un pedido en sus correspondientes líneas de compra o ítems individuales para detallar cantidades.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#datosProveedor</IRI>
        <Literal xml:lang="es">Información de registro o identificador de transacciones devuelto por la pasarela de pago externa.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#descripcion</IRI>
        <Literal xml:lang="es">Texto detallado con las especificaciones del producto o cuerpo de la reseña en un feedback.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#dineroDevuelto</IRI>
        <Literal xml:lang="es">Cuantía total reintegrada con éxito al comprador tras resolverse positivamente una devolución.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#direccionEntrega</IRI>
        <Literal xml:lang="es">Asocia un pedido con la ubicación geográfica detallada a la cual debe ser enviado y entregado el paquete del cliente.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#email</IRI>
        <Literal xml:lang="es">Dirección de correo electrónico del usuario, utilizada para informarle datos sobre su pedido y también para pedir su valoración de los productos que ha comprado.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#empresa</IRI>
        <Literal xml:lang="es">Identifica a la compañía de transportes sobre la cual el agente está tomando una decisión, informando o proponiendo un envío.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#empresaTransporte</IRI>
