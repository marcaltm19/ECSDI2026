    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#fechaPrevistaEntrega</IRI>
        <Literal xml:lang="es">Fecha estimada u objetivo en la que la empresa de transporte prevé entregar el paquete al cliente.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#fechaSalida</IRI>
        <Literal xml:lang="es">Fecha en el que un lote de paquetes abandona físicamente las instalaciones del Centro Logístico.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#formulario</IRI>
        <Literal xml:lang="es">Cadena de datos estructurada que encapsula los campos requeridos para consultar el estado de un pedido.</Literal>
