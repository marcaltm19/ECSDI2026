    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#importeTotal</IRI>
        <Literal xml:lang="es">Monto económico definitivo a cobrar o facturar, que resulta de sumar subtotal, impuestos y transporte en una compra.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
